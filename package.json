{
  "name": "lumen.css",
  "version": "1.0.0",
  "description": "CSS-only, CSS-variable-configurable, semantic-first framework for productive business applications.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/emirror-de/lumen-css.git"
  },
  "homepage": "https://emirror-de.github.io/lumen-css/",
  "bugs": {
    "url": "https://github.com/emirror-de/lumen-css/issues"
  },
  "keywords": [
    "css",
    "css-framework",
    "design-system",
    "semantic-html",
    "css-variables",
    "accessibility",
    "dark-mode"
  ],
  "style": "css/lumen.css",
  "sideEffects": ["css/*.css"],
  "exports": {
    ".": {
      "style": "./css/lumen.css",
      "default": "./css/lumen.css"
    },
    "./min": {
      "style": "./css/lumen.min.css",
      "default": "./css/lumen.min.css"
    },
    "./css/lumen.css": "./css/lumen.css",
    "./css/lumen.min.css": "./css/lumen.min.css"
  },
  "files": [
    "css/lumen.css",
    "css/lumen.min.css",
    "css/lumen.min.css.map",
    "docs/index.html",
    "docs/showcase.html",
    "docs/recipes.html",
    "docs/browser-support.html",
    "docs/responsibilities.html",
    "docs/logo.png",
    "docs/logo-no-text.png",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "./node_modules/.bin/stylelint 'css/**/*.css' --ignore-pattern 'css/**/*.min.css'",
    "lint:fix": "./node_modules/.bin/stylelint 'css/**/*.css' --ignore-pattern 'css/**/*.min.css' --fix",
    "build": "npm run build:minify",
    "build:minify": "node scripts/build-minify.js",
    "check:release": "node scripts/check-release.js",
    "test:a11y": "npx playwright test --project=a11y --project=a11y-dark",
    "test:visual": "npx playwright test --project=visual --project=visual-dark --project=visual-narrow",
    "validate": "npm run lint && npm run build && npm run test:a11y"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "cssnano": "^7.0.0",
    "postcss": "^8.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}
